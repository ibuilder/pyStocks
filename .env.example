# Copy to .env and edit. Loaded automatically by stockpredict/config.py.

# Celery broker + result backend (Redis).
STOCKPREDICT_REDIS_URL=redis://localhost:6379/0

# Durable storage. Default (unset) = SQLite file in the cache dir.
# For production, use Postgres/TimescaleDB:
# STOCKPREDICT_DATABASE_URL=postgresql+psycopg2://stock:stock@localhost:5432/stockpredict

# Where price/fundamentals caches + the SQLite DB live.
# STOCKPREDICT_CACHE=C:\Server\pystocks\.cache
